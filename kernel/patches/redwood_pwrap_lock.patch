diff --git a/xnu/files/bsd/dev/redwood_input.c b/xnu/files/bsd/dev/redwood_input.c
index b1e9891c..41643662 100644
--- a/xnu/files/bsd/dev/redwood_input.c
+++ b/xnu/files/bsd/dev/redwood_input.c
@@ -227,6 +227,23 @@ redwood_input_init(void)
 	redwood_mali_init();
 	redwood_connsys_init();
 	redwood_scp_init();
+	redwood_mtkcam_init();
 	redwood_wifi_init();
 	redwood_adsp_init();
 }
+
+/* One transaction at a time on the PMIC wrapper (redwood_mtkcam.c, redwood_mtkkeys.c, redwood_connsys.c each drive its WACS2 channel by hand). */
+static LCK_GRP_DECLARE(redwood_pwrap_grp, "redwood-pwrap");
+static LCK_MTX_DECLARE(redwood_pwrap_mtx, &redwood_pwrap_grp);
+
+void
+redwood_pwrap_lock(void)
+{
+	lck_mtx_lock(&redwood_pwrap_mtx);
+}
+
+void
+redwood_pwrap_unlock(void)
+{
+	lck_mtx_unlock(&redwood_pwrap_mtx);
+}
diff --git a/xnu/files/bsd/sys/redwood_input.h b/xnu/files/bsd/sys/redwood_input.h
index 9bdc91e5..baba72e8 100644
--- a/xnu/files/bsd/sys/redwood_input.h
+++ b/xnu/files/bsd/sys/redwood_input.h
@@ -81,6 +81,9 @@ void redwood_adreno_stop(void);         /* before that, where the ending is no p
 void redwood_adreno_minute(void);       /* once a minute: a line about how warm the GPU is, if it is in use */
 void redwood_scp_init(void);            /* boot-arg scp_step=N: the MT6768's SCP (the sensor hub), steps 1 to N */
 void redwood_connsys_init(void);        /* boot-arg connsys_step=N: the Infinix's CONNSYS (Wi-Fi/BT), steps 1 to N */
+void redwood_pwrap_lock(void);          /* the MT6358 PMIC wrapper (0x1000d000) takes one transaction at a time: the camera, the keys/GPU-voltage and CONNSYS drivers each hold this for a whole one */
+void redwood_pwrap_unlock(void);
+void redwood_mtkcam_init(void);         /* boot-arg mtkcam=1: the Infinix's main camera (S5K JN1), one capture into memory, then all off */
 /* CONNSYS's memory (Android's consys-reserve-memory), and the AP's the Wi-Fi's DMA and BTIF's FIFO use (its
  * wifi-reserve-memory): both outside XNU's, which begins at 0xc0000000 (mtkloader.c) */
 #define REDWOOD_CONNSYS_EMI_PHYS        0x51000000u
